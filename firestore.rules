// ATENCAO: este arquivo guarda as regras de DOIS apps que dividem o mesmo
// banco Firestore do projeto fazenda-e3652. Publicar so uma metade derruba
// o acesso da outra. Se as regras da fazenda mudarem no console, copie a
// mudanca para ca antes do proximo deploy, senao o deploy reverte.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== Fazenda =====================
    // Copiado do que esta publicado no console (versao de 11/08/2026).
    match /farms/{farmId} {
      allow get, write: if request.auth != null;

      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // ================ Gastos Giovanna ==================
    // Sem login: o codigo da carteira e a senha. Por isso o codigo precisa
    // ter de 10 a 24 caracteres, e LIST e proibido na colecao de carteiras
    // (sem isso, qualquer um baixaria a lista de todos os codigos).
    function codigoOk(c) {
      return c.size() >= 10 && c.size() <= 24 && c.matches('^[A-Z0-9]+$');
    }

    match /carteiras/{codigo} {

      allow get: if codigoOk(codigo);

      allow create, update: if codigoOk(codigo)
        && request.resource.data.keys().hasOnly(['orcamento', 'categorias'])
        && request.resource.data.orcamento is number
        && request.resource.data.orcamento >= 0
        && request.resource.data.categorias.size() <= 40;

      allow delete: if false;

      match /lancamentos/{id} {

        allow get, list: if codigoOk(codigo);

        allow create, update: if codigoOk(codigo)
          && request.resource.data.keys().hasOnly(
               ['valor', 'categoria', 'pagamento', 'nota', 'data', 'criadoEm'])
          && request.resource.data.valor is number
          && request.resource.data.valor > 0
          && request.resource.data.valor < 100000000
          && request.resource.data.categoria is string
          && request.resource.data.categoria.size() <= 18
          && request.resource.data.nota is string
          && request.resource.data.nota.size() <= 60
          && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

        allow delete: if codigoOk(codigo);
      }
    }
  }
}
