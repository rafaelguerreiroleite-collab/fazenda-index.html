rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // O DOCUMENTO DA FAZENDA. Só "get": quem sabe o código entra, quem não sabe
    // não descobre quais existem.
    //
    // A versão anterior tentava exatamente isso e NÃO funcionava. Ela era:
    //
    //     match /farms/{farmId} {
    //       allow get, write: if request.auth != null;
    //       match /{document=**} { allow read, write: if request.auth != null; }
    //     }
    //
    // O curinga recursivo {document=**} também casa com ZERO segmentos, então
    // aquele "allow read" de dentro valia para o PRÓPRIO farms/{farmId} — e
    // "read" é "get" mais "list". Resultado: a lista da coleção farms ficava
    // liberada, e qualquer um com um login anônimo (que qualquer um cria, sem
    // cadastro) puxava todos os códigos de fazenda existentes e, com eles,
    // lia e apagava tudo. As regras não podem negar o que outra regra permite:
    // um "allow list: if false" aqui não consertaria nada. A correção é a
    // estrutura, e é a de baixo.
    match /farms/{farmId} {
      allow get, write: if request.auth != null;
    }

    // AS SUBCOLEÇÕES (animals, weighings, bovtrans, avtrans, gertrans, items,
    // moves, anexos). O {col} obriga pelo menos um segmento, então esta regra
    // nunca alcança o documento da fazenda logo acima — que é o ponto todo.
    match /farms/{farmId}/{col}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
