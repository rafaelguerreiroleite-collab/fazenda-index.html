rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /farms/{farmId} {
      // O código da fazenda funciona como senha: o acesso é sempre direto pelo
      // código (get), nunca por listagem da coleção — "list" negado impede que
      // alguém autenticado descubra os códigos existentes.
      allow get, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
